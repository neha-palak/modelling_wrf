{
  "version": "1.0",
  "description": "Fixed teaching display scales, not India-wide climatological limits or regulatory AQI categories. Original numerical values remain unclipped in CSV.",
  "map_extent": [
    67,
    98,
    6,
    38
  ],
  "map_dpi": 100,
  "gif_frame_ms": 600,
  "expected_interval_hours": 3,
  "bucket_mm": null,
  "height_grid_m": [
    0,
    50,
    100,
    200,
    300,
    500,
    750,
    1000,
    1500,
    2000,
    2500,
    3000,
    4000,
    5000,
    6000,
    8000,
    10000,
    12000,
    15000
  ],
  "max_plot_height_m": 8000,
  "fields": {
    "T2": {
      "title": "2 m air temperature",
      "unit": "°C",
      "range": [
        -10,
        50
      ],
      "cmap": "coolwarm"
    },
    "Q2": {
      "title": "2 m water-vapor mixing ratio",
      "unit": "g kg⁻¹",
      "range": [
        0,
        25
      ],
      "cmap": "YlGnBu"
    },
    "PSFC": {
      "title": "Surface pressure",
      "unit": "hPa",
      "range": [
        450,
        1050
      ],
      "cmap": "viridis"
    },
    "U10": {
      "title": "10 m grid-relative x wind",
      "unit": "m s⁻¹",
      "range": [
        -25,
        25
      ],
      "cmap": "RdBu_r"
    },
    "V10": {
      "title": "10 m grid-relative y wind",
      "unit": "m s⁻¹",
      "range": [
        -25,
        25
      ],
      "cmap": "RdBu_r"
    },
    "TSK": {
      "title": "Surface skin temperature",
      "unit": "°C",
      "range": [
        -10,
        65
      ],
      "cmap": "coolwarm"
    },
    "PBLH": {
      "title": "Planetary boundary-layer height",
      "unit": "m",
      "range": [
        0,
        4000
      ],
      "cmap": "viridis"
